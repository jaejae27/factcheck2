rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Allow read/write to all collections for factcheck investigation app
    // Supports teacher auth and student anonymous/session participation
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
